{
  "root": true,
  "env": {
    "es2022": true,
    "node": true
  },
  "ignorePatterns": [
    "node_modules",
    "runner/output",
    "app/build"
  ],
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended"
  ],
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "sourceType": "module"
  },
  "plugins": [
    "@typescript-eslint"
  ]
}
